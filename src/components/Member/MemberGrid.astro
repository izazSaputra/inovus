---
import { Image } from "astro:assets";

import { members, formatBirthDate } from "../../data/members";
import logoInovus from "../../assets/logo/logo_inovus.svg";
---

<section class="members" aria-labelledby="members-title" data-reveal-stagger>
  <p class="members-label" data-reveal>Anggota</p>
  <h2 id="members-title" data-reveal="mask">
    Satu kelas,
    <span>banyak kepala.</span>
  </h2>

  <ul class="members-grid" data-reveal-stagger="90" data-reveal-columns="4">
    {
      members.map((member, index) => (
        <li
          class="member"
          data-reveal
          id={`absen-${String(member.number).padStart(2, "0")}`}
          style={`--column: ${index % 4}`}
        >
          <div class:list={["member-card", { "is-pending": !member.photo }]}>
            {member.photo ? (
              <Image
                src={member.photo.portrait}
                alt={`Foto ${member.name}`}
                width={600}
                class="member-image parallax-photo"
                loading="lazy"
              />
            ) : (
              <span class="member-pending">Foto menyusul</span>
            )}

            <span class="member-number" aria-hidden="true">
              {String(member.number).padStart(2, "0")}
              <span class="member-present">Hadir</span>
            </span>

            {member.role && (
              <span class="member-badge">
                <Image src={logoInovus} alt="" height={20} />
              </span>
            )}

            <div class="member-info">
              {member.role && <p class="member-role">{member.role}</p>}
              <h3>{member.nickname}</h3>
            </div>
          </div>

          <div class="member-details">
            <p class="member-name">{member.name}</p>
            {member.birthDate && (
              <p class="member-meta">{formatBirthDate(member.birthDate)}</p>
            )}
            {member.instagram && (
              <a
                class="member-instagram"
                href={`https://www.instagram.com/${member.instagram}/`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Instagram @${member.instagram}`}
              >
                @{member.instagram} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const members = [...document.querySelectorAll<HTMLElement>(".member")];

  const call = () => {
    const line = window.innerHeight * 0.5;
    for (const member of members) {
      const card = member.querySelector<HTMLElement>(".member-card");
      if (!card) continue;
      const rect = card.getBoundingClientRect();
      member.classList.toggle("is-called", rect.top < line && rect.bottom > line);
    }
  };

  window.addEventListener("scroll", call, { passive: true });
  window.addEventListener("resize", call);
  call();

  for (const card of document.querySelectorAll<HTMLElement>(".member-card")) {
    card.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const rect = card.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      card.style.setProperty("--tilt-x", `${(-y * 8).toFixed(2)}deg`);
      card.style.setProperty("--tilt-y", `${(x * 10).toFixed(2)}deg`);
      card.style.setProperty("--shine-x", `${((x + 0.5) * 100).toFixed(1)}%`);
      card.style.setProperty("--shine-y", `${((y + 0.5) * 100).toFixed(1)}%`);
    });

    card.addEventListener("pointerleave", () => {
      card.style.setProperty("--tilt-x", "0deg");
      card.style.setProperty("--tilt-y", "0deg");
    });
  }
</script>

<style>
  .members {
    padding: 64px 32px 80px;
  }

  .members-label {
    margin-bottom: 16px;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
  }

  h2 {
    font-size: var(--text-heading);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -2px;
  }

  h2 span {
    display: block;
  }

  .member {
    scroll-margin-top: 112px;
  }

  .members-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px 24px;
    margin-top: 48px;
    list-style: none;
  }

  .member-card {
    position: relative;
    isolation: isolate;
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: var(--radius-pillar);
    background-color: var(--primary);
    transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      background-color 400ms ease,
      border-radius 500ms cubic-bezier(0.3, 1.4, 0.5, 1),
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .member-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: radial-gradient(
      circle at var(--shine-x, 50%) var(--shine-y, 50%),
      oklch(100% 0 0 / 0.25),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  .member-card:hover {
    border-radius: 6px 6px 48px 6px;
  }

  .member-card:hover::before {
    opacity: 1;
  }

  .member-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to top,
      oklch(15% 0.1 264 / 0.7),
      transparent 45%
    );
    pointer-events: none;
  }

  .member-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(1.4) contrast(1.1);
    mix-blend-mode: multiply;
    transition:
      filter 500ms ease,
      scale 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .member-card:hover,
  .member.is-called .member-card {
    background-color: var(--surface);
  }

  .member-card.is-pending:hover,
  .member.is-called .member-card.is-pending {
    background-color: var(--primary);
  }

  .member-number {
    transition: color 400ms ease;
  }

  .member-card:not(.is-pending):hover .member-number,
  .member.is-called .member-card:not(.is-pending) .member-number,
  .member:target .member-number {
    color: var(--primary);
  }

  .member-card:hover .member-image,
  .member.is-called .member-image,
  .member:target .member-image {
    filter: grayscale(0) brightness(1) contrast(1);
  }

  .member-card:hover .member-image {
    scale: 1.06;
  }

  .member.is-called .member-card,
  .member.is-called .member-image,
  .member.is-called .member-present,
  .member.is-called .member-info h3 {
    transition-delay: calc(var(--column, 0) * 110ms);
  }

  .member:target .member-card {
    background-color: var(--surface);
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .member-number {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .member-present {
    padding: 4px 8px;
    border-radius: 4px 4px 4px 10px;
    background-color: var(--accent);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-8px) scale(0.6);
    transform-origin: left center;
    transition:
      opacity 300ms ease,
      transform 500ms cubic-bezier(0.3, 1.8, 0.5, 1);
  }

  .member.is-called .member-present {
    opacity: 1;
    transform: none;
  }

  .member-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--surface);
  }

  .member-badge img {
    display: block;
    width: auto;
    height: 20px;
  }

  .member-info {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    z-index: 1;
    color: var(--surface);
  }

  .member-role {
    margin-bottom: 6px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
  }

  .member-info h3 {
    font-family: var(--font-display-solid);
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    transition:
      color 400ms ease,
      transform 500ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .member.is-called .member-info h3 {
    transform: translateY(-4px);
  }

  .member-card:hover .member-info h3 {
    transform: translateY(-6px);
  }

  .member-pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--surface);
    opacity: 0.6;
    font-size: 12px;
    letter-spacing: 1px;
  }

  .member-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-top: 16px;
  }

  .member-name {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .member-meta {
    color: var(--text-muted);
    font-size: 13px;
  }

  .member-instagram {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-block: 2px;
    color: var(--primary);
    font-size: 13px;
    font-weight: 500;
    transition: color 200ms ease;
  }

  .member-instagram:hover {
    color: var(--accent);
  }

  .member-instagram:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
