---
import { Image } from "astro:assets";

import logoInovus from "../../assets/logo/logo_inovus.svg";

const navLinks = [
  { name: "Home", url: "/" },
  { name: "Our Story", url: "/about" },
  { name: "The People", url: "/member" },
  { name: "Moments", url: "/gallery" },
];

const pathName = Astro.url.pathname;
---

<nav aria-label="Navigasi utama">
  <a href="/" class="nav-logo">
    <Image src={logoInovus} alt="Inovus" height={32} />
  </a>
  <ul>
    {
      navLinks.map((link) => {
        const isActive =
          link.url === "/"
            ? pathName === "/"
            : pathName.replace(/\/$/, "") === link.url.replace(/\/$/, "");

        return (
          <li>
            <a
              href={link.url}
              class={isActive ? "active" : ""}
              aria-current={isActive ? "page" : undefined}
            >
              {link.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    padding: 0 192px;
    background-color: var(--background);
    background-image: repeating-linear-gradient(
      to right,
      var(--frame) 0px,
      var(--frame) 20px,
      transparent 20px,
      transparent 32px
    );
    background-position: bottom;
    background-size: 100% 1px;
    background-repeat: no-repeat;
  }

  nav::before,
  nav::after {
    content: "";
    position: absolute;
    bottom: -6px;
    width: 13px;
    height: 13px;
    background:
      linear-gradient(var(--text), var(--text)) center / 100% 1px no-repeat,
      linear-gradient(var(--text), var(--text)) center / 1px 100% no-repeat;
  }

  nav::before {
    left: 154px;
  }
  nav::after {
    right: 154px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
  }

  .nav-logo img {
    display: block;
    width: auto;
    height: 32px;
  }

  ul {
    display: flex;
    gap: 48px;
    list-style: none;
  }

  ul a {
    font-size: 14px;
    transition: color 200ms ease;
  }

  ul a:hover,
  ul a.active {
    color: var(--accent);
  }

  ul a.active {
    font-weight: 500;
  }

  nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
