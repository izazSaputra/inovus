      ></path>
    </svg>
    <p class="pt-motto">Beda kepala. <span>Satu cerita.</span></p>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const ARRIVING = "inovus-transition";
    const INTRO_SEEN = "inovus-intro";

    let arriving = false;
    let intro = false;

    try {
      arriving = sessionStorage.getItem(ARRIVING) === "1";
      sessionStorage.removeItem(ARRIVING);
      intro = !arriving && sessionStorage.getItem(INTRO_SEEN) !== "1";
      sessionStorage.setItem(INTRO_SEEN, "1");
    } catch {}

    if (arriving || intro) root.classList.add("pt-covered");
    if (intro) root.classList.add("pt-intro");

    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const loaded = new Promise((resolve) => {
      if (document.readyState === "complete") resolve();
      else window.addEventListener("load", resolve, { once: true });
    });

    const reveal = () => {
      document.dispatchEvent(new CustomEvent("inovus:reveal"));
      if (!root.classList.contains("pt-covered")) return;

      root.classList.add("pt-revealing");
      setTimeout(() => {
        root.classList.remove("pt-covered", "pt-revealing", "pt-intro");
      }, 1000);
    };

    const minimum = intro ? 2100 : arriving ? 200 : 0;
    const maximum = intro ? 4000 : 1800;
    Promise.race([Promise.all([loaded, wait(minimum)]), wait(maximum)]).then(reveal);

    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      root.classList.remove("pt-leaving", "pt-intro");
      root.classList.add("pt-covered");
      setTimeout(reveal, 100);
    });

    document.addEventListener("click", (event) => {
      const link = event.target.closest("a");
      if (
        !link ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        (link.target && link.target !== "_self") ||
        link.hasAttribute("download")
      ) {
        return;
      }

      const url = new URL(link.href, location.href);
      const samePage =
        url.pathname === location.pathname && url.search === location.search;
      if (url.origin !== location.origin || samePage) return;

      event.preventDefault();
      try {
        sessionStorage.setItem(ARRIVING, "1");
      } catch {}

      root.classList.add("pt-leaving");
      setTimeout(() => {
        location.href = url.href;
      }, 720);
    });
  })();
</script>

<style is:global>
  .page-transition {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    visibility: hidden;
    pointer-events: none;
  }

  html.pt-covered .page-transition,
  html.pt-leaving .page-transition {
    visibility: visible;
    pointer-events: auto;
  }

  .pt-col {
    height: calc(100vh + 120px);
    background-color: var(--primary);
    border-radius: 0 0 0 96px;
    transform: translateY(105%);
  }

  .pt-col:nth-child(2) {
    --pt-order: 1;
  }

  .pt-col:nth-child(3) {
    --pt-order: 2;
  }

  html.pt-covered .pt-col {
    transform: none;
  }

  html.pt-revealing .pt-col {
    animation: pt-lift 700ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
    animation-delay: calc(var(--pt-order, 0) * 80ms);
  }

  html.pt-leaving .pt-col {
    animation: pt-cover 560ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
    animation-delay: calc(var(--pt-order, 0) * 70ms);
  }

  @keyframes pt-lift {
    from {
      transform: none;
    }
    to {
      transform: translateY(-105%);
    }
  }

  @keyframes pt-cover {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  .pt-brand {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    opacity: 0;
    transform: translate(-50%, -50%);
  }

  html.pt-covered .pt-brand {
    opacity: 1;
  }

  html.pt-leaving .pt-brand {
    animation: pt-fade-in 240ms ease 420ms forwards;
  }

  html.pt-revealing .pt-brand {
    animation: pt-brand-out 360ms ease forwards;
  }

  .pt-logo {
    width: 96px;
    height: auto;
    overflow: visible;
  }

  .pt-pillar {
    fill: var(--surface);
  }

  .pt-dot {
    fill: var(--accent);
  }

  .pt-pillar,
  .pt-dot {
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .pt-motto {
    color: var(--surface);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.3px;
    opacity: 0;
  }

  .pt-motto span {
    color: var(--accent);
    font-family: var(--font-display-solid);
    font-weight: 700;
  }

  html.pt-intro .pt-pillar {
    animation: pt-pillar-rise 620ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
  }

  html.pt-intro .pt-pillar-left {
    animation-delay: 150ms;
  }

  html.pt-intro .pt-pillar-middle {
    animation-delay: 300ms;
  }

  html.pt-intro .pt-pillar-right {
    animation-delay: 450ms;
  }

  html.pt-intro .pt-dot {
    animation: pt-dot-drop 700ms cubic-bezier(0.3, 0, 0.2, 1) 900ms backwards;
  }

  html.pt-intro .pt-motto {
    animation: pt-fade-in 500ms ease 1350ms forwards;
  }

  @keyframes pt-pillar-rise {
    from {
      opacity: 0;
      transform: translateY(60%) scaleY(0.4);
    }
  }

  @keyframes pt-dot-drop {
    0% {
      opacity: 0;
      transform: translateY(-260%);
    }
    55% {
      opacity: 1;
      transform: translateY(0) scale(1.15, 0.8);
    }
    75% {
      transform: translateY(-30%) scale(0.95, 1.05);
    }
    100% {
      transform: none;
    }
  }

  @keyframes pt-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes pt-brand-out {
    to {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 40px));
    }
  }
</style>
