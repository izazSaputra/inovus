<div class="page-transition" aria-hidden="true">
  <span class="pt-col"></span>
  <span class="pt-col"></span>
  <span class="pt-col"></span>

  <div class="pt-brand">
    <svg class="pt-logo" viewBox="0 0 170 201" fill="none">
      <path
