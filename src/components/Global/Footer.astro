<footer class="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a href="/" class="footer-logo">inovus<span>.</span></a>
      <p>Beda kepala. <span>Satu cerita</span>.</p>
    </div>

    <nav aria-label="Navigasi footer">
      <a href="/">Home</a>
      <a href="/tentang">Our Story</a>
      <a href="/anggota">The People</a>
      <a href="/galeri">Moments</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <span>PTI-B / ANGKATAN 2025</span>
    <span>Universitas Negeri Malang</span>
  </div>
</footer>

<style>
  .footer {
    padding: 48px 32px 24px;
    background-color: var(--primary);
    color: var(--surface);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    padding-bottom: 40px;
  }

  .footer-logo {
    color: var(--surface);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .footer-logo span {
    color: var(--accent);
  }

  .footer-brand p {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.5;
  }

  .footer-brand p span {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--accent);
    font-weight: 700;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  nav a {
    padding-block: 8px;
    color: var(--surface);
    font-size: 14px;
  }

  .footer a:hover {
    color: var(--surface);
    opacity: 0.8;
  }

  .footer a:focus-visible {
    outline: 2px solid var(--surface);
    outline-offset: 4px;
  }

  .footer nav a:hover {
    color: var(--accent);
    opacity: 0.8;
  }

  .footer nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--surface);
    font-size: 11px;
    letter-spacing: 1px;
  }
</style>
