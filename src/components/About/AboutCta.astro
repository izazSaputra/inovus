<section class="about-cta" aria-labelledby="about-cta-title" data-reveal-stagger>
  <p class="about-cta-label" data-reveal>Lebih dekat</p>
  <h2 id="about-cta-title" data-reveal="mask">
    Udah kenal ceritanya?
    <span>Sekarang kenalan orangnya.</span>
  </h2>
  <p class="about-cta-description" data-reveal>
    Ada banyak wajah di balik Inovus. Yuk lihat siapa aja mereka dan
    momen-momennya.
  </p>

  <div class="cta-action" data-reveal>
    <a class="button-primary" href="/member">
      Lihat anggota
    </a>

    <a class="button-secondary" href="/gallery">
      Lihat galeri
    </a>
  </div>
</section>

<style>
  .about-cta {
    padding: 90px 32px 90px;
    text-align: center;
  }

  .about-cta-label {
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
  }

  .about-cta h2 {
    margin-top: 32px;
    font-size: var(--text-heading);
    line-height: 1.15;
    letter-spacing: -2px;
    font-weight: 500;
  }

  .about-cta h2 span {
    display: block;
  }

  .about-cta-description {
    max-width: 500px;
    margin: 40px auto 0;
    line-height: 1.6;
    font-size: 15px;
    color: var(--text-muted);
  }

  .cta-action {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 36px;
    margin-top: 32px;
  }

  .cta-action a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .button-primary {
    background-color: var(--primary);
    color: var(--surface);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .button-primary:hover {
    color: var(--text);
    background-color: var(--accent);
  }

  .button-secondary:hover {
    color: var(--accent);
  }

  .cta-action a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
