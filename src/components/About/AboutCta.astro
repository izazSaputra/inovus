<section class="about-cta" aria-labelledby="about-cta-title">
  <p class="about-cta-label">03 / LEBIH DEKAT</p>
  <h2 id="about-cta-title">
    Udah kenal ceritanya?
    <span>Sekarang kenalan orangnya.</span>
  </h2>
  <p class="about-cta-description">
    Ada banyak wajah di balik Inovus. Yuk lihat siapa aja mereka dan
    momen-momennya.
  </p>

  <div class="cta-action">
    <a class="button-primary" href="/member">
      Lihat anggota <span aria-hidden="true">↗</span>
    </a>

    <a class="button-secondary" href="/gallery">
      Lihat galeri <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .about-cta {
    padding: 90px 32px 90px;
    text-align: center;
  }

  .about-cta-label {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .about-cta h2 {
    margin-top: 32px;
    font-size: 3.6rem;
    line-height: 1.05;
    letter-spacing: -4px;
    font-weight: 500;
  }

  .about-cta h2 span {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--primary);
    letter-spacing: -0.9px;
  }

  .about-cta-description {
    max-width: 500px;
    margin: 40px auto 0;
    line-height: 1.6;
    font-size: 15px;
    color: var(--text-muted);
  }

  .cta-action {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 36px;
    margin-top: 32px;
  }

  .cta-action a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .button-primary {
    background-color: var(--primary);
    color: var(--surface);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .button-primary:hover {
    color: var(--text);
    background-color: var(--accent);
  }

  .button-secondary:hover {
    color: var(--accent);
  }

  .cta-action a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
