---
const heroFacts = [
  { label: "Kelas", value: "PTI-B" },
  { label: "Angkatan", value: "2025" },
  { label: "Kampus", value: "Universitas Negeri Malang" },
];
---

<section class="about-hero" aria-labelledby="about-hero-title">
  <p class="about-hero-label">
    PTI-B <span aria-hidden="true">/</span> ANGKATAN 2025
  </p>

  <h1 id="about-hero-title">
    Kenal <span>Inovus</span>
    <br />
    lebih dekat.
  </h1>

  <p class="about-hero-description">
    Satu kelas, banyak kepala, dan cerita yang terus bertambah. Di sini kamu
    bisa kenalan sama orang-orangnya dan momen yang kami simpan bersama.
  </p>

  <dl class="about-hero-facts">
    {
      heroFacts.map((fact) => (
        <div class="about-hero-fact">
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .about-hero {
    padding: 160px 32px 0;
    text-align: center;
  }

  .about-hero-label {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .about-hero-label span {
    color: var(--accent);
  }

  .about-hero h1 {
    margin-top: 30px;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -4px;
  }

  .about-hero h1 span {
    display: inline;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 1.15em;
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 0;
  }

  .about-hero-description {
    max-width: 600px;
    margin: 20px auto 0;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .about-hero-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 96px -32px 0;
    background-image:
      repeating-linear-gradient(
        to right,
        var(--frame) 0px,
        var(--frame) 20px,
        transparent 20px,
        transparent 32px
      ),
    background-position:
      left top,
      left bottom;
    background-size:
      100% 1px,
      100% 1px;
    background-repeat: no-repeat;
  }

  .about-hero-fact {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    text-align: left;
  }

  .about-hero-fact + .about-hero-fact {
    background-image: repeating-linear-gradient(
      to bottom,
      var(--frame) 0px,
      var(--frame) 20px,
      transparent 20px,
      transparent 32px
    );
    background-position: left top;
    background-size: 1px 100%;
    background-repeat: no-repeat;
  }

  .about-hero-fact dt {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .about-hero-fact dd {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.5px;
  }

  .about-hero-fact:first-child dd {
    color: var(--primary);
  }
</style>
