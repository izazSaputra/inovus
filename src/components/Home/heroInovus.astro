---
import { Image } from "astro:assets";

import homePreview from "../../assets/indexPreview/previewIndex.jpg";
---

<section class="hero" aria-labelledby="hero-title">
  <p class="hero-label">
    PTI-B <span aria-hidden="true">/</span> ANGKATAN 2025
  </p>

  <div class="hero-main">
    <h1 id="hero-title">
      Beda kepala.
      <span>Satu cerita.</span>
    </h1>

    <div class="hero-side">
      <p class="hero-description">
        Tempat cerita, tawa, dan langkah kecil kita.
        <br />
        Dari PTI-B, Universitas Negeri Malang.
      </p>
      <div class="hero-action">
        <a class="button-primary" href="/about">
          Kenalan sama kita <span aria-hidden="true">↗</span>
        </a>

        <a class="button-secondary" href="/gallery">
          Lihat galeri <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-photo">
    <Image
      src={homePreview}
      alt="Foto bersama kelas PTI-B angkatan 2025 Universitas Negeri Malang"
      class="hero-image"
      width={2240}
    />
    <span class="photo-label">INOVUS / PTI-B 2025</span>
  </div>
</section>

<style>
  .hero {
    padding: 160px 32px 80px;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .hero-label span {
    color: var(--accent);
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    align-items: end;
    gap: 64px;
    margin-top: 32px;
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -4px;
  }

  h1 span {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 1.15em;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .hero-description {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .hero-action {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
  }

  .hero-action a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .button-primary {
    background-color: var(--primary);
    color: var(--surface);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .button-primary:hover {
    color: var(--text);
    background-color: var(--accent);
  }

  .button-secondary {
    transition: color 250ms ease;
  }

  .button-secondary:hover {
    color: var(--accent);
  }

  .hero-action a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .hero-photo {
    position: relative;
    height: 560px;
    margin: 64px calc(-32px - 6.125vw) 0;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--placeholder-color);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 33.5%;
  }

  .photo-label {
    position: absolute;
    bottom: 24px;
    left: 24px;
    padding: 8px 12px;
    border-radius: 6px;
    background-color: var(--background);
    color: var(--text);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
  }
</style>
