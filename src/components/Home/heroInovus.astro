---
import { Image } from "astro:assets";

import { members } from "../../data/members";

const pad = (number: number) => String(number).padStart(2, "0");
---

<section class="hero" aria-labelledby="hero-title">
  <script is:inline>
    // Absen pembuka: wajah muncul satu per satu.
    // Ditulis langsung di sini supaya kelasnya terpasang sebelum wajah tampil.
    // Animasinya hanya perubahan warna, jadi tetap diputar walau "reduce motion"
    // aktif; yang dihilangkan hanya gerakan geser di judul (lihat CSS).
    //
    // Diputar ulang saat:
    // - halaman dibuka atau di-refresh,
    // - kembali ke Home lewat tombol Back (halaman dipulihkan dari cache),
    // - dinding wajah masuk lagi ke layar setelah sempat keluar sepenuhnya.
    (() => {
      const hero = document.currentScript.parentElement;

      const play = () => {
        hero.classList.remove("is-roll-call", "is-waiting");
        // Paksa browser menghitung ulang gaya supaya animasi mulai dari awal.
        void hero.offsetWidth;
        hero.classList.add("is-roll-call");
      };

      hero.classList.add("is-roll-call", "is-waiting");
      const start = () => hero.classList.remove("is-waiting");
      window.addEventListener("load", start, { once: true });
      setTimeout(start, 2500);

      window.addEventListener("pageshow", (event) => {
        if (event.persisted) play();
      });

      document.addEventListener("DOMContentLoaded", () => {
        const wall = hero.querySelector(".hero-wall");
        let hasLeft = false;

        new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) {
              hasLeft = true;
            } else if (hasLeft && entry.intersectionRatio >= 0.35) {
              hasLeft = false;
              play();
            }
          },
          { threshold: [0, 0.35] },
        ).observe(wall);
      });
    })();
  </script>

  <p class="hero-label">
    PTI-B <span aria-hidden="true">/</span> ANGKATAN 2025
  </p>

  <div class="hero-wall">
    <h1 id="hero-title" class="hero-motto">
      Beda kepala.
      <span>Satu cerita.</span>
    </h1>

    {
      members.map((member, index) => (
        <a
          class:list={["hero-face", { "hero-face-empty": !member.photo }]}
          style={`--i: ${index}`}
          href={`/member#absen-${pad(member.number)}`}
          aria-label={`${member.nickname}, nomor absen ${member.number}`}
        >
          {member.photo ? (
            <Image
              src={member.photo.face}
              alt=""
              width={240}
              class="hero-face-image"
              loading="eager"
            />
          ) : (
            <span class="hero-face-pending" aria-hidden="true">
              {member.nickname}
            </span>
          )}
          <span class="hero-face-number" aria-hidden="true">
            {pad(member.number)}
          </span>
        </a>
      ))
    }
  </div>

  <div class="hero-footer">
    <p class="hero-description">
      Tempat cerita, tawa, dan langkah kecil kita. {members.length} orang dari
      PTI-B, Universitas Negeri Malang.
    </p>

    <div class="hero-action">
      <a class="button-primary" href="/member">Kenalan sama kita</a>
      <a class="button-secondary" href="/about">Cerita kami</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 128px 32px 80px;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .hero-label span {
    color: var(--accent);
  }

  .hero-wall {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 8px;
    margin-top: 32px;
  }

  .hero-motto {
    grid-column: 3 / span 5;
    grid-row: 2 / span 2;
    align-self: center;
    padding: 0 24px;
    font-size: 72px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -3px;
  }

  .hero-motto span {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 1.15em;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .hero-face {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-pillar-small);
    background-color: var(--primary);
    transition: background-color 400ms ease;
  }

  .hero-face-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(1.4) contrast(1.1);
    mix-blend-mode: multiply;
    transition: filter 400ms ease;
  }

  .hero-face:hover,
  .hero-face:focus-visible {
    background-color: var(--surface);
  }

  .hero-face:hover .hero-face-image,
  .hero-face:focus-visible .hero-face-image {
    filter: grayscale(0) brightness(1) contrast(1);
  }

  .hero-face:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hero-face-number {
    position: absolute;
    bottom: 6px;
    left: 8px;
    z-index: 1;
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    transition: color 400ms ease;
  }

  .hero-face:hover .hero-face-number,
  .hero-face:focus-visible .hero-face-number {
    color: var(--primary);
  }

  .hero-face-pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--surface);
    opacity: 0.7;
    font-size: 12px;
  }

  .hero-face:hover .hero-face-pending {
    color: var(--primary);
  }

  .hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
    margin-top: 40px;
  }

  .hero-description {
    max-width: 440px;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .hero-action {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .hero-action a {
    display: inline-flex;
    align-items: center;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .button-primary {
    background-color: var(--primary);
    color: var(--surface);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .button-primary:hover {
    color: var(--text);
    background-color: var(--accent);
  }

  .button-secondary {
    transition: color 250ms ease;
  }

  .button-secondary:hover {
    color: var(--accent);
  }

  .hero-action a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .is-roll-call .hero-motto {
    animation: motto-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }

  .is-roll-call .hero-face {
    animation: roll-call-tile 1100ms ease backwards;
    animation-delay: calc(500ms + var(--i) * 35ms);
  }

  .is-roll-call .hero-face-image,
  .is-roll-call .hero-face-pending,
  .is-roll-call .hero-face-number {
    animation: roll-call-face 1100ms ease backwards;
    animation-delay: calc(500ms + var(--i) * 35ms);
  }

  .is-roll-call .hero-face-empty {
    animation-name: none;
  }

  .is-roll-call .hero-face-pending {
    animation-name: roll-call-pending;
  }

  .is-roll-call .hero-face-number {
    animation-name: roll-call-number;
  }

  .is-waiting .hero-motto,
  .is-waiting .hero-face,
  .is-waiting .hero-face-image,
  .is-waiting .hero-face-pending,
  .is-waiting .hero-face-number {
    animation-play-state: paused;
  }

  @keyframes motto-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes motto-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes roll-call-tile {
    0% {
      background-color: var(--primary);
    }
    25%,
    50% {
      background-color: var(--surface);
    }
    100% {
      background-color: var(--primary);
    }
  }

  @keyframes roll-call-face {
    0% {
      opacity: 0;
      filter: grayscale(0) brightness(1) contrast(1);
    }
    25%,
    50% {
      opacity: 1;
      filter: grayscale(0) brightness(1) contrast(1);
    }
    100% {
      opacity: 1;
      filter: grayscale(1) brightness(1.4) contrast(1.1);
    }
  }

  @keyframes roll-call-pending {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 0.7;
    }
  }

  @keyframes roll-call-number {
    0% {
      opacity: 0;
    }
    25%,
    50% {
      opacity: 1;
      color: var(--primary);
    }
    100% {
      opacity: 1;
      color: var(--surface);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-roll-call .hero-motto {
      animation-name: motto-fade;
    }

    .hero-face,
    .hero-face-image,
    .hero-face-number {
      transition: none;
    }
  }
</style>
