---
import { Image } from "astro:assets";

import homePreview from "../../assets/indexPreview/previewIndex.jpg";
---

<section class="hero" aria-labelledby="hero-title">
  <p class="hero-label">
    PTI-B <span aria-hidden="true">/</span> ANGKATAN 2025
  </p>

  <h1 id="hero-title">
    Beda kepala.
    <span>Satu cerita.</span>
  </h1>

  <p class="hero-description">
    Tempat cerita, tawa, dan langkah kecil kita.
    <br />
    Dari PTI-B, Universitas Negeri Malang.
  </p>

  <div class="hero-action">
    <a class="button-primary" href="/tentang">
      Kenalan sama kita <span aria-hidden="true">↗</span>
    </a>

    <a class="button-secondary" href="/galeri">
      Lihat galeri <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="hero-photo">
    <Image
      src={homePreview}
      alt="Foto bersama kelas PTI-B angkatan 2025 Universitas Negeri Malang"
      class="hero-image"
      width={2240}
    />
    <span class="photo-label">INOVUS / PTI-B 2025</span>
  </div>
</section>

<style>
  .hero {
    padding: 160px 32px 80px;
    text-align: center;
  }

  .hero-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .hero-label span {
    color: var(--accent);
  }

  h1 {
    margin-top: 3.5rem;
    font-size: 88px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -5px;
  }

  h1 span {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 100px;
    letter-spacing: -2px;
  }

  .hero-description {
    margin-top: 15px;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.4;
  }

  .hero-action {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .hero-action a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .button-primary {
    background-color: var(--primary);
    color: var(--surface);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .button-primary:hover {
    color: var(--text);
    background-color: var(--accent);
  }

  .button-secondary:hover {
    color: var(--accent);
  }

  .hero-action a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .hero-photo {
    position: relative;
    height: 400px;
    margin-top: 64px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--placeholder-color);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 33.5%;
  }

  .photo-label {
    position: absolute;
    top: 18vw;
    left: 24px;
    padding: 8px 12px;
    border-radius: 6px;
    background-color: var(--background-blur);
    color: var(--text);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .photo-content p {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
  }

  .photo-content span {
    display: block;
    margin-top: 12px;
    color: var(--text-muted);
    font-size: 13px;
  }
</style>
