<section class="hero" aria-labelledby="hero-title">
  <p class="hero-label">
    PTI-B <span aria-hidden="true">/</span> ANGKATAN 2025
  </p>

  <h1 id="hero-title">
    Beda kepal.
    <span>Satu cerita.</span>
  </h1>

  <p class="hero-description">
    Tempat cerita, tawa, dan langkah kecil kita.
    <br />
    Dari PTI-B, Universitas Negeri Malang.
  </p>
</section>

<style>
  .hero {
    padding: 160px 32px 80px;
    text-align: center;
  }

  .hero-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .hero-label span {
    color: var(--accent);
  }

  h1 {
    margin-top: 3.5rem;
    font-size: 88px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -5px;
  }

  h1 span {
    display: block;
    color: var(--primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 100px;
    letter-spacing: -2px;
  }

  .hero-description {
    margin-top: 15px;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.4;
  }
</style>
