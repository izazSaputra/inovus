---
import { Image } from "astro:assets";

import homePreview from "../../assets/indexPreview/previewIndex.jpg";
---

<section class="class-photo" aria-label="Foto bersama kelas Inovus">
  <figure>
    <div class="class-photo-frame">
      <Image
        src={homePreview}
        alt="Foto bersama kelas PTI-B angkatan 2025 Universitas Negeri Malang"
        class="class-photo-image"
        width={2240}
      />
    </div>
    <figcaption>Beda kepala, satu frame.</figcaption>
  </figure>
</section>

<style>
  .class-photo {
    padding: 0 32px 80px;
  }

  .class-photo-frame {
    height: 560px;
    margin: 0 calc(-32px - 6.125vw);
    overflow: hidden;
    border-radius: var(--radius-pillar);
    background-color: var(--placeholder-color);
  }

  .class-photo-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 33.5%;
  }

  figcaption {
    margin-top: 16px;
    color: var(--text-muted);
    font-size: 14px;
  }
</style>
