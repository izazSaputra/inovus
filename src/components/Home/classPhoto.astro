---
import { Image } from "astro:assets";

import homePreview from "../../assets/indexPreview/previewIndex.jpg";
---

<section class="class-photo" aria-label="Foto bersama kelas Inovus">
  <figure>
    <div class="class-photo-frame">
      <Image
        src={homePreview}
        alt="Foto bersama kelas PTI-B angkatan 2025 Universitas Negeri Malang"
        class="class-photo-image"
        width={2240}
      />
    </div>
    <figcaption>Beda kepala, satu frame.</figcaption>
  </figure>
</section>

<style>
  .class-photo {
    padding: 0 32px 80px;
  }

  .class-photo-frame {
    height: 560px;
    margin: 0 calc(-32px - 6.125vw);
    overflow: hidden;
    border-radius: var(--radius-pillar);
    background-color: var(--placeholder-color);
  }

  .class-photo-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 33.5%;
  }

  figcaption {
    margin-top: 16px;
    color: var(--text-muted);
    font-size: 14px;
  }

  /*
   * Dari satu kotak ke seluruh kelas: saat di-scroll, bingkai membuka dari
   * kotak kecil di tengah menjadi penuh, sementara foto zoom-out.
   * Mengikuti posisi scroll (scroll-driven animation), tanpa JavaScript.
   * Browser yang belum mendukung (misalnya Firefox) menampilkan foto biasa.
   */
  @supports (animation-timeline: view()) {
    .class-photo-frame {
      view-timeline-name: --class-photo;
      animation: class-photo-open linear both;
    }

    .class-photo-image {
      transform-origin: center 33.5%;
      animation: class-photo-zoom linear both;
    }

    /* Timeline sengaja ditulis di aturan terpisah (selektor lebih spesifik):
       kalau digabung, minifier memasukkannya ke shorthand `animation`
       dan browser menolak seluruh deklarasinya. */
    .class-photo .class-photo-frame,
    .class-photo .class-photo-image {
      animation-timeline: --class-photo;
      animation-range: entry 50% cover 50%;
    }

    /* Untuk "reduce motion": bingkai tetap membuka, tapi tanpa zoom. */
    @media (prefers-reduced-motion: reduce) {
      .class-photo-image {
        animation: none;
      }
    }
  }

  @keyframes class-photo-open {
    from {
      clip-path: inset(30% 40% 30% 40% round 6px 6px 6px 24px);
    }
    to {
      clip-path: inset(0 0 0 0 round 6px 6px 6px 48px);
    }
  }

  @keyframes class-photo-zoom {
    from {
      transform: scale(1.8);
    }
    to {
      transform: scale(1);
    }
  }
</style>
