---
import "lenis/dist/lenis.css";
import "../styles/global.css";
import PageTransition from "../components/Global/PageTransition.astro";

export interface props {
  pageTitle: string;
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{Astro.props.pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <PageTransition />
    <slot />
    <script>
      import Lenis from "lenis";

      const lenis = new Lenis({
        autoRaf: true,
        anchors: true,
        stopInertiaOnNavigate: true,
        respectReducedMotion: false,
      });

      const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
      const hero = document.querySelector<HTMLElement>(".hero");
      const photos = [...document.querySelectorAll<HTMLElement>(".parallax-photo")];
      const classPhotos = [...document.querySelectorAll<HTMLElement>(".class-photo-frame")];

      const update = () => {
        const viewport = window.innerHeight;

        if (hero) {
          const rect = hero.getBoundingClientRect();
          hero.style.setProperty("--hero-p", clamp(-rect.top / rect.height).toFixed(4));
        }

        for (const photo of photos) {
          const rect = (photo.parentElement ?? photo).getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > viewport) continue;
          const progress = (viewport - rect.top) / (viewport + rect.height);
          photo.style.setProperty("--p", clamp(progress).toFixed(4));
        }

        for (const frame of classPhotos) {
          const rect = frame.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          frame.style.setProperty("--reveal", clamp((viewport - center) / (viewport / 2)).toFixed(4));
        }
      };

      lenis.on("scroll", update);
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();

      for (const group of document.querySelectorAll<HTMLElement>("[data-reveal-stagger]")) {
        const step = Number(group.dataset.revealStagger) || 90;
        const offset = Number(group.dataset.revealOffset) || 0;
        const columns = Number(group.dataset.revealColumns) || 0;
        const items = group.querySelectorAll<HTMLElement>(":scope > [data-reveal]");
        items.forEach((item, index) => {
          const position = columns ? index % columns : index;
          item.style.setProperty("--reveal-delay", `${offset + position * step}ms`);
        });
      }

      const revealItems = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
      let revealTops: number[] = [];
      let revealing = false;

      const layoutTop = (element: HTMLElement) => {
        let top = 0;
        let node: HTMLElement | null = element;
        while (node) {
          top += node.offsetTop;
          node = node.offsetParent as HTMLElement | null;
        }
        return top;
      };

      const measureReveal = () => {
        revealTops = revealItems.map(layoutTop);
      };

      const checkReveal = () => {
        if (!revealing) return;
        const line = window.scrollY + window.innerHeight * 0.92;
        revealItems.forEach((element, index) => {
          if (revealTops[index] < line) element.classList.add("is-revealed");
        });
      };

      const startReveal = () => {
        if (revealing) return;
        revealing = true;
        measureReveal();
        checkReveal();
      };

      lenis.on("scroll", checkReveal);
      window.addEventListener("scroll", checkReveal, { passive: true });
      window.addEventListener("resize", () => {
        measureReveal();
        checkReveal();
      });
      window.addEventListener("load", measureReveal);
      document.addEventListener("inovus:reveal", startReveal);
      setTimeout(startReveal, 4500);
    </script>
  </body>
</html>
